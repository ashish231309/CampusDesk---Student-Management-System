# ---------------------------------------------------------------------------
# CampusDesk web client — environment template
# Copy to client/.env.local if you need to override anything.
# Only VITE_-prefixed variables are exposed to the browser, so never put a
# secret in this file.
# ---------------------------------------------------------------------------

# Where the browser sends API calls. Keep the default while developing: Vite
# proxies /api to the backend (see VITE_API_PROXY_TARGET) and the browser never
# has to know the API's address.
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:5000

# Client-side request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Sign-in state is a bearer token the client keeps in localStorage and sends as
# `Authorization: Bearer <token>`; there is no client-side flag that can fake a
# session.
