# ---------------------------------------------------------------------------
# CampusDesk API — environment template
# Copy to server/.env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api
LOG_LEVEL=debug

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/campusdesk
# How long to wait for a server when connecting (ms)
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# How long a query may wait for a connection before it fails with a 503 (ms)
MONGODB_BUFFER_TIMEOUT_MS=2000

# Authentication — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Comma-separated list of frontend origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Request throttling
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
